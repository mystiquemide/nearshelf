# Server-side only. Never prefix these with NEXT_PUBLIC_.

# Qloo hackathon API key (https://hackathon.api.qloo.com).
QLOO_API_KEY=

# NVIDIA API key. Runs the agent and the plain-LLM comparison.
# Without it, runs use the fixed tool sequence and the comparison panel shows as unavailable.
NVIDIA_API_KEY=

# Popularity ceiling between 0 and 1. Books above it are rejected as too big.
# 0.995 separates megahits (0.9996 and up in Qloo) from mid-list titles. Leave empty to turn the size rule off.
POPULARITY_MAX=0.995

# "Readers also love" panel (podcasts and TV shows from Qloo). Set to "on" to show it.
ALSO_LOVE=on
